{
  "name": "lliam-gov",
  "version": "1.0.0",
  "description": "A security-as-code case study for a capable, governed AI knowledge-work agent.",
  "private": true,
  "workspaces": [
    "apps/*",
    "ui-tui",
    "ui-tui/packages/*",
    "web"
  ],
  "scripts": {
    "postinstall": "echo '✅ Browser tools ready. Run: python run_agent.py --help'",
    "install:root": "npm install --workspaces=false",
    "install:web": "npm install --workspace web",
    "install:tui": "npm install --workspace ui-tui",
    "install:desktop": "npm install --workspace apps/desktop",
    "audit:root": "npm audit --workspaces=false",
    "audit:web": "npm audit --workspace web",
    "audit:tui": "npm audit --workspace ui-tui",
    "audit:fix:root": "npm audit fix --workspaces=false",
    "audit:fix:web": "npm audit fix --workspace web",
    "audit:fix:tui": "npm audit fix --workspace ui-tui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdavis-cyber/lliam-gov.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jdavis-cyber/lliam-gov/issues"
  },
  "homepage": "https://secondorderstrategy.com/work/lliam-gov",
  "dependencies": {
    "@streamdown/math": "^1.0.2",
    "agent-browser": "^0.26.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "@assistant-ui/store": "0.2.13",
    "yauzl": "^3.3.1",
    "colord": "2.9.4",
    "sanitize-html": "2.17.7",
    "source-map-js": "1.2.2",
    "postcss": {
      ".": "8.5.23",
      "nanoid": "3.3.18"
    },
    "undici@^6": "6.28.1",
    "undici@^7": "7.29.1",
    "shell-quote": "1.12.0",
    "tar": "7.5.22",
    "@xmldom/xmldom": "0.8.15",
    "axios": "1.20.0",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "browserslist": "4.28.7",
    "fast-uri@^3": "3.1.8",
    "http-cache-semantics": "4.3.0",
    "joi": "18.2.9",
    "js-yaml@^4": "4.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
